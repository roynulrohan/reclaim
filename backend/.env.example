# Copy to .env and fill in your values. Don't commit .env.

DB_URL=jdbc:postgresql://localhost:5432/reclaim
DB_USERNAME=YOUR_POSTGRES_USER
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# At least 32 characters
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_OF_32_OR_MORE_CHARACTERS

# Only used to create the first admin when there are no users yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

CORS_ALLOWED_ORIGINS=http://localhost:5173
