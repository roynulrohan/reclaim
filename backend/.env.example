# Copy this file to .env in the same folder and fill in your values.
# .env is ignored by Git. Never commit real passwords.
# Format: KEY=value, no quotes, no spaces around =.

# Database: point these at your own PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/reclaim
DB_USERNAME=YOUR_POSTGRES_USER
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
