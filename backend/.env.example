# Copy this file to .env in the same folder and fill in your values.
# .env is ignored by Git. Never commit real passwords.
# Format: KEY=value, no quotes, no spaces around =.

# Database: point these at your own PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/reclaim
DB_USERNAME=YOUR_POSTGRES_USER
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# Secret used to sign login tokens. Any random text, at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_OF_32_OR_MORE_CHARACTERS

# The first admin account, created on the first run when there are no users yet.
# Changing these later does nothing once that account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Frontend addresses allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
